"""
Example logging configuration for production. This file shows a `dictConfig`-style
configuration you can load with `logging.config.dictConfig`.

Notes:
- Set `LOG_DIR` environment variable to change log directory (default: `logs`).
- Prefer emitting logs to stdout in containerized environments and use a log
  aggregation service (ELK, Datadog, Cloud Logging) to collect them.
"""

LOGGING = {
    "version": 1,
    "disable_existing_loggers": False,
    "formatters": {
        "standard": {
            "format": "%(asctime)s %(levelname)s %(name)s: %(message)s",
        }
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "level": "INFO",
            "formatter": "standard",
            "stream": "ext://sys.stdout",
        },
        "file": {
            "class": "logging.handlers.RotatingFileHandler",
            "level": "INFO",
            "formatter": "standard",
            "filename": "logs/app.log",
            "mode": "a",
            "maxBytes": 5 * 1024 * 1024,
            "backupCount": 5,
        },
    },
    "root": {"handlers": ["console", "file"], "level": "INFO"},
    "loggers": {
        "code_review_agent.webhook": {"handlers": ["console", "file"], "level": "DEBUG", "propagate": False}
    },
}

# Example usage in your code:
# import logging.config, os
# from logging.conf import LOGGING  # or import from this file
# logging.config.dictConfig(LOGGING)